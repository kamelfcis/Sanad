# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File uploads use Supabase Storage bucket "uploads" (see supabase/migrations/00013_storage_uploads.sql)

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional; defaults to mailto:admin@sanad.app in code
VAPID_SUBJECT=mailto:admin@sanad.app

# Email notifications (transactional). Off by default.
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# SENDGRID_API_KEY=
EMAIL_FROM=Sanad <notifications@sanad.app>
# EMAIL_FROM_ADDRESS=notifications@sanad.app

# App-level API throttle (src/proxy.ts). Set to "false" to disable (E2E/local).
RATE_LIMIT_ENABLED=true

# Error monitoring — optional. No-op when unset. See docs/ENVIRONMENT.md.
SENTRY_DSN=